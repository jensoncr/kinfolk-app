# Hosted Supabase project:
# https://supabase.com/dashboard/project/your-project-ref
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-hosted-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-hosted-service-role-key
SUPABASE_PROJECT_ID=your-project-ref

# Local development alternatives:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-from-supabase-start
# SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key-from-supabase-start

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_replace-with-clerk-secret-key

# Production/staging should proxy Clerk through Kinfolk's domain so the LinkedIn
# OAuth callback is first-party, e.g. https://usekinfolk.com/clerk-proxy/v1/oauth_callback.
# Leave this unset for local development; enabling the proxy on localhost causes
# Clerk to reject the host unless that local host is configured for the instance.
# NEXT_PUBLIC_CLERK_PROXY_URL=/clerk-proxy

# Optional server-side LinkedIn enrichment service. LinkedIn sign-in itself
# stays on Clerk's standard OIDC scopes: openid profile email. Do not add
# r_basicprofile or r_profile_basicinfo to sign-in: those restricted enrichment
# permissions can make authentication fail when the LinkedIn app is unapproved.
# LINKEDIN_ENRICHMENT_ENDPOINT=
# LINKEDIN_ENRICHMENT_API_KEY=
KINFOLK_JOBS_SECRET=replace-with-random-secret-before-production

# Founder failure alerts. Agent failure paths text this E.164 number via the
# active text transport (max 1 text per reason per 30 minutes). Leave unset to
# log alerts only; see docs/OPERATIONS.md.
KINFOLK_FOUNDER_ALERT_PHONE=

# Public base URL for Kinfolk. Required for the text agent to render listing
# recommendation cards, group-join profile cards, and the onboarding contact
# card sent after phone verification.
NEXT_PUBLIC_KINFOLK_BASE_URL=http://localhost:3000
# Optional local-dev helper. When npm run dev exposes NEXT_PUBLIC_KINFOLK_BASE_URL
# as a trycloudflare tunnel, desktop clicks on the SMS enrichment handoff redirect
# back here so localhost Clerk/session cookies can hydrate the form.
KINFOLK_DEV_LOCAL_BASE_URL=http://localhost:3000
# Optional. Defaults to NEXT_PUBLIC_KINFOLK_BASE_URL in the onboarding contact card.
KINFOLK_CONTACT_WEBSITE_URL=
# One dedicated random secret per signing boundary. Production fails closed
# (throws at first use) when any of these is unset; local dev falls back to a
# dev-only value so nothing here is required for localhost.
KINFOLK_LISTING_CARD_SECRET=replace-with-random-secret-before-production
KINFOLK_PROFILE_CARD_SECRET=replace-with-random-secret-before-production
KINFOLK_PHONE_VERIFICATION_SECRET=replace-with-random-secret-before-production
CONTACT_GRAPH_HASH_SECRET=replace-with-random-secret-before-production
OPENROUTER_API_KEY=
KINFOLK_TEXT_AGENT_MODEL=google/gemini-3.1-flash-lite
KINFOLK_TEXT_AGENT_REASONING_EFFORT=minimal
# Optional. Set to false to force no reasoning tokens; DeepSeek models default
# to this behavior in code because reasoning tokens otherwise dominate latency.
KINFOLK_TEXT_AGENT_REASONING_ENABLED=
KINFOLK_LISTING_FEATURE_VISION_MODEL=google/gemini-2.5-flash-lite
KINFOLK_EMBEDDING_MODEL=openai/text-embedding-3-small
KINFOLK_EMBEDDING_DIMENSIONS=1536
KINFOLK_MATCH_USE_EMBEDDINGS=true
KINFOLK_MATCH_RETRIEVAL_LIMIT=150
KINFOLK_MATCH_RERANK_LIMIT=80
KINFOLK_MATCH_MIN_COSINE=0.25
KINFOLK_MATCH_DEBUG=false
KINFOLK_SYNTHETIC_ROOMMATE_GROUPS_ENABLED=false

# Text transport for Continue on iPhone / text profile agent.
# Use "sendblue" while developing on the Sendblue free API trial, or "linq"
# when Linq is live again.
KINFOLK_TEXT_TRANSPORT=sendblue
KINFOLK_SMS_AGENT_ENABLED=true
# Keep local contact/SMS QA dry-run by default. Set false only when you intend
# to send real iMessages/SMS from the configured transport.
KINFOLK_TEXT_TRANSPORT_DRY_RUN=true
# Optional local-dev helper. When true, npm run dev updates Sendblue receive /
# outbound webhooks to the current trycloudflare tunnel URL.
KINFOLK_DEV_GATEWAY_SYNC_SENDBLUE=false

# Linq transport. Create the webhook subscription at:
# https://your-domain.com/api/webhooks/linq?version=2026-02-03
# Subscribe to message.received, message.sent, message.failed, chat.created,
# message.delivered, message.read, message.edited, reaction.added,
# reaction.removed, and phone_number.status_updated.
LINQ_API_KEY=
LINQ_FROM_NUMBER=+14155550100
LINQ_WEBHOOK_SIGNING_SECRET=

# Sendblue transport. Configure dashboard webhooks at:
# https://your-domain.com/api/webhooks/sendblue
# Enable at least Inbound Messages; Outbound Messages gives delivery status
# updates. Set the global secret in Sendblue to match this value; Sendblue sends
# it in the sb-signing-secret header.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_WEBHOOK_SIGNING_SECRET=
SENDBLUE_API_BASE_URL=https://api.sendblue.co

# Development bearer token for the profile-enrichment MCP endpoint. Production
# should replace this with OAuth-issued scoped access tokens.
KINFOLK_MCP_BEARER_TOKEN=replace-with-random-secret-before-production
KINFOLK_MCP_USER_ID=
KINFOLK_MCP_CLERK_USER_ID=
KINFOLK_MCP_EMAIL=
KINFOLK_ALLOW_UNAUTHENTICATED_MCP_DEV=false

# Mapbox GL JS public token. Create one at https://account.mapbox.com/access-tokens/
# Must be a "pk." token; restrict it to localhost for dev and your domain for prod.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.replace-with-your-mapbox-public-token

# Optional area-signal integrations for listing/neighborhood research probes.
# DataSF works without a token, but an app token is better for repeated jobs.
# GOOGLE_PLACES_API_KEY is preferred; GCP_API_KEY is also accepted locally.
# HOWLOUD_API_KEY is preferred; HOW_LOUD_API_KEY is also accepted locally.
DATASF_APP_TOKEN=
GOOGLE_PLACES_API_KEY=
GCP_API_KEY=
HOWLOUD_API_KEY=
# 511.org SF Bay realtime transit departures in commute replies (free token at https://511.org/open-data/token; ~60 req/hr quota, cached 60s per stop).
TRANSIT_511_API_KEY=
# RentCast AVM rent estimates for text-agent price checks (free tier = 50 calls/month; responses cached on the listing row for 14 days).
RENTCAST_API_KEY=

# Apartment listing ingestion. Use a licensed provider or API export.
LISTINGS_IMPORT_PROVIDER=
LISTINGS_IMPORT_MARKET=san-francisco-ca
LISTINGS_IMPORT_URL=
LISTINGS_IMPORT_INPUT=
LISTINGS_IMPORT_BATCH_SIZE=100
LISTINGS_IMPORT_USER_AGENT=
LISTINGS_IMPORT_EXPAND_PRICE_BANDS=true
LISTINGS_IMPORT_EXPAND_RESULT_PAGES=true
LISTINGS_IMPORT_RESULT_PAGE_LIMIT=120
LISTINGS_IMPORT_QUALITY=true
LISTINGS_IMPORT_MARK_REJECTED_INACTIVE=true
LISTINGS_IMPORT_QUALITY_MAX_REJECTED_RATIO=0.2
LISTINGS_IMPORT_QUALITY_MIN_REJECTED_BEFORE_ABORT=10
LISTINGS_IMPORT_QUALITY_MIN_RENT_PER_BEDROOM=
LISTINGS_IMPORT_RETRIES=3
LISTINGS_IMPORT_RETRY_DELAY_MS=500
KINFOLK_APARTMENT_MARKET=san-francisco-ca
KINFOLK_APARTMENT_LISTING_LIMIT=1000
LISTINGS_DETAIL_ENRICHMENT_LIMIT=25
LISTINGS_DETAIL_ENRICHMENT_CONCURRENCY=2
LISTINGS_DETAIL_REQUEST_DELAY_MS=150
LISTINGS_DETAIL_RETRIES=3
LISTINGS_DETAIL_RETRY_DELAY_MS=500
LISTINGS_PHOTO_SYNC_LIMIT=1000
LISTINGS_PHOTO_SYNC_BATCH_SIZE=500
LISTINGS_PHOTO_SYNC_MAX_PER_LISTING=80
LISTINGS_PHOTO_SYNC_VALIDATE_FIRST=false
LISTINGS_PHOTO_SYNC_VALIDATION_RETRIES=3
LISTINGS_PHOTO_SYNC_VALIDATION_RETRY_DELAY_MS=500
LISTINGS_UNIT_SYNC_LIMIT=1000
LISTINGS_UNIT_SYNC_BATCH_SIZE=250

# Agent observability
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=kinfolk-imessage-agent
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Simulation evals (see evals/README.md; provision with scripts/provision-eval-identity.mjs)
KINFOLK_EVAL_USER_ID=
KINFOLK_EVAL_THREAD_ID=

# Brandfetch brand search — powers the company typeahead in the profile and
# /me/enrich work fields. Search works without credentials; this optional ID
# attributes requests to your integration (https://developers.brandfetch.com/register).
# School search is unaffected — it runs off a bundled dataset.
BRANDFETCH_CLIENT_ID=
